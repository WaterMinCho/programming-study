{
  "title": "격자 배치를 표로 적기",
  "type": "return",
  "level": 3,
  "points": 8,
  "mode": "call",
  "tags": ["배치와 창 크기", "이중 for", "문자열 조합"],
  "examples": 3,
  "cases": [
    {"call": "solution([\"수량\", \"입력\", \"확인\", \"취소\"], [0, 0, 1, 1], [0, 1, 1, 2])", "expected": "['수량 입력 .', '. 확인 취소']"},
    {"call": "solution([\"A\"], [0], [0])", "expected": "['A']"},
    {"call": "solution([\"닫기\"], [2], [1])", "expected": "['. .', '. .', '. 닫기']"},
    {"call": "solution([\"C\", \"A\", \"B\"], [1, 0, 0], [0, 0, 1])", "expected": "['A B', 'C .']"},
    {"call": "solution([\"위\", \"아래\"], [0, 3], [0, 0])", "expected": "['위', '.', '.', '아래']"},
    {"call": "solution([\"1\", \"2\", \"3\"], [0, 0, 0], [2, 0, 4])", "expected": "['2 . 1 . 3']"},
    {"call": "solution([\"P\", \"Q\"], [2, 0], [0, 3])", "expected": "['. . . Q', '. . . .', 'P . . .']"},
    {"call": "solution([\"7\", \"8\", \"9\", \"4\", \"5\", \"6\", \"0\"], [0, 0, 0, 1, 1, 1, 2], [0, 1, 2, 0, 1, 2, 1])", "expected": "['7 8 9', '4 5 6', '. 0 .']"},
    {"call": "solution([\"X\"], [0], [3])", "expected": "['. . . X']"}
  ]
}
