{
  "title": "JSON 성적 파일 요약",
  "type": "return",
  "level": 3,
  "points": 8,
  "mode": "call",
  "tags": [
    "json 변환 함수",
    "중첩 자료 접근",
    "파일 예외 처리"
  ],
  "examples": 3,
  "cases": [
    {
      "files": {
        "scores.json": "{\n    \"class\": \"A\",\n    \"students\": [\n        {\"name\": \"kim\", \"scores\": [80, 90, 70]},\n        {\"name\": \"lee\", \"scores\": []},\n        {\"name\": \"park\", \"scores\": [100, 95]}\n    ]\n}\n"
      },
      "call": "solution(\"scores.json\")",
      "expected": "{'class': 'A', 'count': 3, 'averages': {'kim': 80.0, 'park': 97.5}, 'best': 'park'}"
    },
    {
      "call": "solution(\"none.json\")",
      "expected": "{}"
    },
    {
      "files": {
        "empty.json": "{\"class\": \"B\", \"students\": [{\"name\": \"a\", \"scores\": []}]}"
      },
      "call": "solution(\"empty.json\")",
      "expected": "{'class': 'B', 'count': 1, 'averages': {}, 'best': None}"
    },
    {
      "files": {
        "c.json": "{\"class\": \"C\", \"students\": []}\n"
      },
      "call": "solution(\"c.json\")",
      "expected": "{'class': 'C', 'count': 0, 'averages': {}, 'best': None}"
    },
    {
      "files": {
        "tie.json": "{\"class\": \"T\", \"students\": [{\"name\": \"x\", \"scores\": [90]}, {\"name\": \"y\", \"scores\": [80, 100]}, {\"name\": \"z\", \"scores\": [90]}]}"
      },
      "call": "solution(\"tie.json\")",
      "expected": "{'class': 'T', 'count': 3, 'averages': {'x': 90.0, 'y': 90.0, 'z': 90.0}, 'best': 'x'}"
    },
    {
      "files": {
        "zero.json": "{\"class\": \"Z\", \"students\": [{\"name\": \"p\", \"scores\": [0, 0]}, {\"name\": \"q\", \"scores\": [0]}]}"
      },
      "call": "solution(\"zero.json\")",
      "expected": "{'class': 'Z', 'count': 2, 'averages': {'p': 0.0, 'q': 0.0}, 'best': 'p'}"
    },
    {
      "files": {
        "order.json": "{\"students\": [{\"scores\": [50], \"name\": \"solo\"}], \"class\": \"K\"}"
      },
      "call": "solution(\"order.json\")",
      "expected": "{'class': 'K', 'count': 1, 'averages': {'solo': 50.0}, 'best': 'solo'}"
    },
    {
      "files": {
        "other.json": "{\n    \"class\": \"A\",\n    \"students\": [\n        {\"name\": \"kim\", \"scores\": [80, 90, 70]},\n        {\"name\": \"lee\", \"scores\": []},\n        {\"name\": \"park\", \"scores\": [100, 95]}\n    ]\n}\n"
      },
      "call": "solution(\"scores.json\")",
      "expected": "{}"
    },
    {
      "files": {
        "long.json": "{\"class\": \"L\", \"students\": [{\"name\": \"a\", \"scores\": []}, {\"name\": \"b\", \"scores\": [70, 71, 74]}, {\"name\": \"c\", \"scores\": [72]}, {\"name\": \"d\", \"scores\": [100, 43]}]}"
      },
      "call": "solution(\"long.json\")",
      "expected": "{'class': 'L', 'count': 4, 'averages': {'b': 71.66666666666667, 'c': 72.0, 'd': 71.5}, 'best': 'c'}"
    },
    {
      "files": {
        "last.json": "{\n  \"class\": \"M\",\n  \"students\": [\n    {\"name\": \"u\", \"scores\": [10]},\n    {\"name\": \"v\", \"scores\": []},\n    {\"name\": \"w\", \"scores\": [99, 100]}\n  ]\n}\n"
      },
      "call": "solution(\"last.json\")",
      "expected": "{'class': 'M', 'count': 3, 'averages': {'u': 10.0, 'w': 99.5}, 'best': 'w'}"
    }
  ]
}
