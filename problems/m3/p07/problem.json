{
  "title": "창고 출고 처리",
  "type": "return",
  "level": 2,
  "points": 6,
  "mode": "call",
  "tags": [
    "딕셔너리 추가·삭제",
    "in과 not in",
    "튜플 반환"
  ],
  "examples": 3,
  "cases": [
    {
      "call": "solution({\"펜\": 5, \"자\": 2}, [(\"펜\", 3), (\"자\", 2), (\"풀\", 1), (\"펜\", 4)])",
      "expected": "({'펜': 2}, 2)"
    },
    {
      "call": "solution({\"a\": 1}, [(\"a\", 1), (\"a\", 1)])",
      "expected": "({}, 1)"
    },
    {
      "call": "solution({\"b\": 2, \"a\": 5}, [])",
      "expected": "({'b': 2, 'a': 5}, 0)"
    },
    {
      "call": "solution({}, [(\"a\", 1), (\"b\", 2)])",
      "expected": "({}, 2)"
    },
    {
      "call": "solution({\"x\": 3}, [(\"x\", 3)])",
      "expected": "({}, 0)"
    },
    {
      "call": "solution({\"b\": 2, \"a\": 5, \"c\": 1}, [(\"a\", 1), (\"c\", 1)])",
      "expected": "({'b': 2, 'a': 4}, 0)"
    },
    {
      "call": "solution({\"x\": 3}, [(\"x\", 4), (\"x\", 2), (\"x\", 2), (\"x\", 1)])",
      "expected": "({}, 2)"
    },
    {
      "call": "solution({\"물\": 10, \"빵\": 1}, [(\"빵\", 1), (\"빵\", 1), (\"물\", 10), (\"물\", 1)])",
      "expected": "({}, 2)"
    },
    {
      "call": "solution({\"k\": 1000}, [(\"k\", 999)])",
      "expected": "({'k': 1}, 0)"
    },
    {
      "call": "solution({\"a\": 2, \"b\": 2}, [(\"b\", 3), (\"a\", 1), (\"a\", 2), (\"a\", 1)])",
      "expected": "({'b': 2}, 2)"
    },
    {
      "call": "solution({\"a\": 4}, [(\"a\", 5), (\"a\", 4)])",
      "expected": "({}, 1)"
    }
  ]
}
