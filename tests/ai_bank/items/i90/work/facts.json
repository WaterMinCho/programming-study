  {"id": "F90-01", "from": "시험 #1", "text": "기울기의 반대 방향으로 옮기면 손실이 줄어듭니다.", "verdict": "맞음", "core": true, "where": ["90차시 슬 p2"], "checked": "2026-11-03"},
  {"id": "F90-02", "from": "시험 #2", "text": "zero_grad 는 쌓인 값을 비웁니다.", "verdict": "맞음", "core": true, "where": ["90차시 노트북 01 [2]"], "checked": "2026-11-03"},
  {"id": "F90-03", "from": "시험 #3", "text": "새 W 는 W 에서 학습률과 기울기의 곱을 뺀 값입니다.", "verdict": "맞음", "core": true, "where": ["90차시 슬 p2"], "checked": "2026-11-03"},
  {"id": "F90-04", "from": "시험 #4", "text": "훈련 손실은 줄고 검증 손실이 커지는 현상을 과적합이라고 합니다.", "verdict": "맞음", "core": true, "where": ["90차시 슬 p4"], "checked": "2026-11-03"},
  {"id": "F90-05", "from": "시험 #5", "text": "과적합된 모델은 처음 보는 자료에서 더 자주 틀립니다.", "verdict": "맞음", "where": ["90차시 슬 p4"], "checked": "2026-11-03"},
  {"id": "F90-06", "from": "시험 #6", "text": "검증 자료는 학습에 쓰지 않습니다.", "verdict": "맞음", "where": ["90차시 슬 p5"], "checked": "2026-11-03"},
  {"id": "F90-07", "from": "시험 #7", "text": "조기 종료는 검증 손실이 이어 나빠지면 학습을 멈춥니다.", "verdict": "맞음", "where": ["90차시 슬 p6"], "checked": "2026-11-03"},
  {"id": "F90-08", "from": "시험 #8", "text": "배치 수는 자료 수를 배치 크기로 나눈 값을 올림한 것입니다.", "verdict": "맞음", "where": ["90차시 노트북 01 [3]"], "checked": "2026-11-03"},
  {"id": "F90-09", "from": "시험 #9", "text": "학습률이 크면 발산합니다.", "verdict": "단순화", "ask_as": "학습률이 크면 손실이 줄지 않고 커질 수 있습니다.", "where": ["90차시 슬 p7"], "checked": "2026-11-03"},
  {"id": "F90-10", "from": "시험 (d)", "text": "손실 값은 실행마다 조금씩 다릅니다.", "verdict": "맞음", "concept_only": true, "where": ["90차시 노트북 01 [4]"], "checked": "2026-11-03"},
  {"id": "F90-11", "from": "시험 #11", "text": "step 이 쌓인 값을 비웁니다.", "verdict": "틀림", "where": ["90차시 슬 p3"], "checked": "2026-11-03"}
