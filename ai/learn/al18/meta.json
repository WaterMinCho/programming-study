 "sections": {
  "a18a": "사진 한 장을 잘라 모델 입력으로 바꾸기",
  "a18b": "펼친 영상에서 정한 색 범위만 남기기",
  "a18c": "프레임마다 물체의 중심을 원본 좌표로 기록하기",
  "a18d": "성공한 점만 골라 변위를 구하고 다음 프레임으로 넘기기",
  "a18e": "점수에서 사진마다 예측 이름을 찾기",
  "a18f": "특징 채널 사이의 곱을 Gram 행렬로 모으기",
  "a18g": "판별기 단계에서 생성기와 기울기 끊기",
  "a18h": "사진 특징을 첫 자리로 붙인 뒤 유효한 캡션만 쓰기",
  "a18i": "앞쪽 점이 남긴 투과율로 광선의 색 합치기",
  "a18j": "목표 클래스의 입력 기여도 비교하기",
  "a18k": "같은 정답 박스를 두 번 세지 않기"
 },
